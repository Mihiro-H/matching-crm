# 環境変数テンプレート（実際の値は .env に記載）
# API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here

# Supabase (TECH_STACK.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook受信(フェーズC): 各サービスの共有シークレット(暫定方式)
FORM_WEBHOOK_SECRET=
CLOUDSIGN_WEBHOOK_SECRET=
FREEE_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Zoom
ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom等システム起因で作成するレコードのcreated_byに使う、
# public.usersに存在する実ユーザーのUUID(「システム用」ユーザーを1件作成して設定する)
SYSTEM_USER_ID=

# レポート定期実行(フェーズC5)のcronエンドポイント認証
CRON_SECRET=
